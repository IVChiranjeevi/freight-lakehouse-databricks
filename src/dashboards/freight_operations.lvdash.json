{
  "datasets": [
    {
      "name": "ds_status",
      "displayName": "Shipment status",
      "queryLines": [
        "SELECT shipment_id, house_bill_number, customer_id, transport_mode, service_level,\n",
        "       origin_code, destination_code, shipment_status, is_delivered, is_on_time,\n",
        "       is_overdue_in_transit, exception_count, transit_hours, booking_date, delivery_date\n",
        "FROM gold.shipment_status\n"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily operations KPIs",
      "queryLines": [
        "SELECT * FROM gold.daily_operations_kpis\n"
      ]
    },
    {
      "name": "ds_overdue",
      "displayName": "Overdue in transit",
      "queryLines": [
        "SELECT house_bill_number, customer_id, transport_mode,\n",
        "       concat(origin_code, ' → ', destination_code) AS lane, shipment_status,\n",
        "       planned_delivery_ts, last_event_ts, exception_count,\n",
        "       round((unix_timestamp(current_timestamp()) - unix_timestamp(planned_delivery_ts)) / 3600, 1) AS hours_late\n",
        "FROM gold.shipment_status\n",
        "WHERE is_overdue_in_transit\n",
        "ORDER BY planned_delivery_ts\n"
      ]
    },
    {
      "name": "ds_carriers",
      "displayName": "Carrier scorecard",
      "queryLines": [
        "SELECT carrier_name, transport_mode, contract_type, shipments, delivered, on_time_pct,\n",
        "       exception_rate_pct, avg_transit_hours, carrier_spend_usd, cost_per_kg\n",
        "FROM gold.carrier_scorecard\n"
      ]
    },
    {
      "name": "ds_lanes",
      "displayName": "Top lanes",
      "queryLines": [
        "SELECT transport_mode, concat(origin_code, ' → ', destination_code) AS lane, shipments, on_time_pct,\n",
        "       avg_transit_hours, revenue_usd, gross_margin_usd,\n",
        "       round(100 * gross_margin_usd / nullif(revenue_usd, 0), 1) AS margin_pct, revenue_per_kg\n",
        "FROM gold.lane_performance\n",
        "WHERE revenue_usd > 0\n",
        "ORDER BY gross_margin_usd DESC\n",
        "LIMIT 25\n"
      ]
    },
    {
      "name": "ds_customers",
      "displayName": "Customer profitability",
      "queryLines": [
        "SELECT customer_name, account_tier, industry, country_code, shipments, cancelled_shipments,\n",
        "       on_time_pct, revenue_usd, gross_margin_usd, gross_margin_pct, avg_revenue_per_shipment\n",
        "FROM gold.customer_profitability\n",
        "WHERE revenue_usd IS NOT NULL\n"
      ]
    },
    {
      "name": "ds_ar",
      "displayName": "AR aging",
      "queryLines": [
        "SELECT CASE aging_bucket WHEN 'CURRENT' THEN '0. Current' WHEN '1-30' THEN '1. 1-30 days'\n",
        "            WHEN '31-60' THEN '2. 31-60 days' WHEN '61-90' THEN '3. 61-90 days' ELSE '4. 90+ days' END AS aging_bucket,\n",
        "       open_invoices, open_amount_usd\n",
        "FROM gold.ar_aging\n"
      ]
    },
    {
      "name": "ds_customs",
      "displayName": "Customs clearance",
      "queryLines": [
        "SELECT import_country, broker, entries, pending_entries, avg_clearance_hours,\n",
        "       p90_clearance_hours, inspection_rate_pct, duties_usd\n",
        "FROM gold.customs_clearance_kpis\n"
      ]
    }
  ],
